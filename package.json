{
  "name": "pip-todo",
  "version": "0.3.0",
  "private": true,
  "description": "PIP — a personal/team work-log dashboard. Full-stack: Express + SQLite backend, LED-pixel frontend.",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "dev": "webpack --mode development --watch & node server/index.js",
    "server": "node server/index.js",
    "snapshot": "node scripts/pip-snapshot.js",
    "snapshot:deploy": "node scripts/pip-snapshot.js && npx --yes netlify-cli deploy --dir snapshot --prod",
    "screens": "node scripts/pip-screens.js",
    "test:touch": "node scripts/pip-touch-test.js",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/**/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.mjs\"",
    "test:all": "npm run lint && npm run format:check && npm test && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:mutation": "node scripts/pip-mutation-check.js",
    "ingest:assets": "node scripts/pip-ingest-assets.js",
    "seed:demo": "node scripts/demo-data/index.js",
    "snapshot:demo": "node scripts/pip-snapshot-demo.js",
    "demo:check": "node scripts/demo-data/freshnessCheck.js"
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.0",
    "@fontsource/vt323": "^5.1.0",
    "animejs": "^3.2.2",
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.2",
    "mammoth": "^1.12.0",
    "marked": "^13.0.3",
    "pdfjs-dist": "^6.2.108"
  }
}
