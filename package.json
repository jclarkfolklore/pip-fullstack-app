{
  "name": "pip-todo",
  "version": "0.3.0",
  "private": true,
  "description": "PIP \u2014 a personal/team work-log dashboard. Full-stack: Express + SQLite backend, LED-pixel frontend.",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "dev": "webpack --mode development --watch & node server/index.js",
    "server": "node server/index.js",
    "snapshot": "node scripts/pip-snapshot.js",
    "snapshot:deploy": "node scripts/pip-snapshot.js && npx --yes netlify-cli deploy --dir snapshot --prod",
    "screens": "node scripts/pip-screens.js",
    "test:touch": "node scripts/pip-touch-test.js"
  },
  "devDependencies": {
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright-core": "^1.62.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.0",
    "@fontsource/vt323": "^5.1.0",
    "animejs": "^3.2.2",
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.2",
    "marked": "^13.0.3"
  }
}
